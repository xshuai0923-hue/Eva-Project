COMPOSE_PROJECT_NAME=eva-project
TAG=17.8.0-slim
POSTGRES_VERSION=17
OPENPROJECT_HTTPS=true
OPENPROJECT_HSTS=true
OPENPROJECT_HOST__NAME=evaproject.example.invalid
OPENPROJECT_ADDITIONAL__HOST__NAMES=["web","evaproject.example.invalid"]
OPENPROJECT_DEFAULT__LANGUAGE=zh-CN
OPENPROJECT_SEED__ADMIN__USER__PASSWORD=GENERATE_ON_SERVER
OPENPROJECT_SEED__ADMIN__USER__PASSWORD__RESET=false
OPENPROJECT_SEED__ADMIN__USER__NAME=Eva Project Admin
OPENPROJECT_SEED__ADMIN__USER__MAIL=admin@eva-project.local
PORT=127.0.0.1:28080
MCP_PORT=28081
MCP_BIND_ADDRESS=127.0.0.1
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,mcp,evaproject.example.invalid
SECRET_KEY_BASE=GENERATE_ON_SERVER
POSTGRES_PASSWORD=GENERATE_ON_SERVER
DATABASE_URL=postgres://postgres:GENERATE_ON_SERVER@db/openproject?pool=20&encoding=unicode&reconnect=true
COLLABORATIVE_SERVER_URL=wss://evaproject.example.invalid/hocuspocus
COLLABORATIVE_SERVER_SECRET=GENERATE_ON_SERVER
MCP_BEARER_TOKEN=GENERATE_ON_SERVER
OPENPROJECT_API_TOKEN=PENDING_BOOTSTRAP
EVAPROJECT_ROOT=/srv/eva-project/current
EVAPROJECT_RUNTIME=/srv/eva-project/runtime
PGDATA=/srv/eva-project/data/postgres
OPDATA=/srv/eva-project/data/openproject/assets
RAILS_MIN_THREADS=4
RAILS_MAX_THREADS=16
IMAP_ENABLED=false
OPENPROJECT_PUBLIC_URL=https://evaproject.example.invalid
EVAPROJECT_ADMIN_URL=https://mcp.evaproject.example.invalid/admin/
EVAPROJECT_UID=1000
EVAPROJECT_GID=1000
EVAPROJECT_TZ=Asia/Hong_Kong
EVAPROJECT_BACKUP=/srv/eva-project/backup
EVAPROJECT_MCP_PUBLIC_URL=https://mcp.eva-project.example.invalid/mcp
